{
  "name": "flight-data-service",
  "version": "1.0.0",
  "private": true,
  "description": "Runwy flight data service with provider normalization, tracking, alerts, and caching.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "build:airports": "node scripts/build-airports-dataset.js",
    "doctor": "node scripts/doctor.js",
    "test": "node --test test/*.test.js",
    "start": "node src/start.js",
    "start:api": "ENABLE_TRACKING_POLLER=false node src/server.js",
    "start:poller": "node src/flight-poller.js",
    "start:firehose": "node src/flight-firehose.js",
    "start:all": "ENABLE_TRACKING_POLLER=true node src/server.js",
    "prepare:liveries": "node scripts/prepare-liveries.js",
    "upload:liveries": "node scripts/upload-liveries.js",
    "dev": "npm run dev:api",
    "dev:api": "ENABLE_TRACKING_POLLER=false node --watch src/server.js",
    "dev:poller": "node --watch src/flight-poller.js",
    "dev:firehose": "node --watch src/flight-firehose.js",
    "test:database": "node --test test/database-hardening.test.js",
    "db:status": "node scripts/db-migrate.js",
    "db:migrate": "node scripts/db-migrate.js --apply",
    "db:verify": "node scripts/db-migrate.js --verify"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.2.0",
    "pg": "^8.11.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "tz-lookup": "^6.1.25"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
